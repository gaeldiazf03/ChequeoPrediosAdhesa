# Flask
APP_NAME=ADHESA Smart Map
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA
FLASK_DEBUG=0

# Runtime
APP_HOST=0.0.0.0
APP_PORT=5000
RUN_SCHEDULERS=1

# Database
SQLITE_DB_PATH=adhesa.db

# SmartMap toggle
ENABLE_SMARTMAP_ALERTS=0

# SMTP
SMTP_HOST=smtp.tu-dominio.com
SMTP_PORT=587
SMTP_USER=usuario_smtp
SMTP_PASSWORD=tu_password_seguro
SMTP_USE_TLS=true
SMTP_FROM=alertas@tu-dominio.com
ALERT_EMAIL_TO=equipo@tu-dominio.com

# Integracion opcional de unidades
UNITS_API_URL=
UNITS_API_KEY=

# Schedulers
ENABLE_NOTIFICATION_RETRY_SCHEDULER=1
ENABLE_REPORT_SCHEDULER=1
NOTIFICATION_RETRY_BASE_SECONDS=300
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_INTERVAL_SECONDS=300
REPORT_SCHEDULER_INTERVAL_SECONDS=300
